# Copy to .env and fill in. .env is git-ignored; never commit real values.
PORT=3001
DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5433/bookleaf
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# AI is optional: without a key, classification uses keyword rules and drafts are "unavailable"
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
# Used only to estimate spend on GET /api/admin/ai/usage (Haiku 5.5, prompts up to 100K tokens)
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50
